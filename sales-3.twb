      <aliases enabled='yes' />
      <column caption='Profit' datatype='real' name='[Calculation_0633089738510336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) * 0.30' />
      </column>
      <column caption='Profit Margin ' datatype='real' name='[Calculation_0633089739292673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0633089738510336] / SUM([Sales])' />
      </column>
      <column caption='shipping days' datatype='integer' name='[Calculation_0633089739436034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
      </column>
      <column caption='Order year' datatype='integer' name='[Calculation_0633089740017667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Order Date])' />
      </column>
      <column caption='Order Month' datatype='string' name='[Calculation_0633089740124164]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[Order Date])' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_0633089740316677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
      <column caption='Delivery Speed Category' datatype='string' name='[Calculation_0633089740419078]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0633089739436034] &lt;=2 THEN &quot;Fast&quot;&#13;&#10;ELSEIF [Calculation_0633089739436034] &lt;=5 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;Slow&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_0633089740709895]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Order ID]) &gt; 1 THEN &quot;Repeat Customer&quot;&#13;&#10;ELSE &quot;New Customer&quot;&#13;&#10;END' />
      </column>
      <column caption='Sales Insight' datatype='string' name='[Calculation_0633089762758666]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) = WINDOW_MAX(SUM([Sales])) THEN&#13;&#10;&quot;HIGHEST SALES MONTH&quot;&#13;&#10;ELSEIF SUM([Sales]) = WINDOW_MIN(SUM([Sales])) THEN&#13;&#10;&quot;LOWEST SALES MONTH&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
